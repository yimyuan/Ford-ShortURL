NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:5173
# Local = direct. Render behind the Netlify edge proxy = netlify.
PROXY_MODE=direct
# Netlify and Render must share the same random secret (at least 32 bytes).
PROXY_SECRET=
REDIS_URL=
# Local: redis://127.0.0.1:6379; hosted Redis: rediss://...
# Generate separate random secrets (at least 32 bytes each) before starting authentication.
JWT_SECRET=
CSRF_SECRET=
JWT_ISSUER=short-url-api
JWT_AUDIENCE=short-url-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Backend only. Do not put the secret key in frontend/VITE_* variables.
# Project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# One-time CLI setup only. Never use these for regular login or in frontend.
# Leave password empty to generate a local password file; remove supplied password after setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

